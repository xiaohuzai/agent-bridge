{
  "name": "browsa-agent-bridge",
  "version": "0.1.0",
  "description": "Local daemon that turns CLI coding agents (codex, claude code, … any ACP agent) into an HTTP+SSE chat backend any client can drive — plus opt-in ACP doors: a WebSocket endpoint for ACP clients and a spawnable stdio agent mode. Zero dependencies.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "browsa-agent-bridge": "cli.mjs"
  },
  "files": [
    "cli.mjs",
    "server.mjs",
    "serve.mjs",
    "wire-ws.mjs",
    "acp-front.mjs",
    "acp-front-ws.mjs",
    "acp-front-stdio.mjs",
    "agents-registry.mjs",
    "agents.example.json",
    "adapters/",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaohuzai/agent-bridge.git"
  },
  "keywords": [
    "agent",
    "codex",
    "claude",
    "acp",
    "agent-client-protocol",
    "bridge",
    "gateway",
    "cli",
    "sse",
    "local-llm",
    "byok"
  ]
}
