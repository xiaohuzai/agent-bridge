{
  "name": "browsa-agent-bridge",
  "version": "0.1.0",
  "description": "Local bridge that turns CLI agents (codex today; claude code & more next) into a localhost HTTP+SSE chat backend for any client. Zero dependencies.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "browsa-agent-bridge": "cli.mjs"
  },
  "files": [
    "cli.mjs",
    "server.mjs",
    "serve.mjs",
    "agents-registry.mjs",
    "adapters/",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaohuzai/agent-bridge.git"
  },
  "keywords": [
    "agent",
    "codex",
    "claude",
    "bridge",
    "gateway",
    "cli",
    "sse",
    "local-llm",
    "byok"
  ]
}
