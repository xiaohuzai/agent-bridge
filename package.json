{
  "name": "@xiaohuzai/agent-bridge",
  "version": "0.4.0",
  "description": "Local daemon that turns CLI coding agents (codex, claude code, gemini, pi, … any ACP agent) into an HTTP+SSE chat backend any client can drive — plus opt-in ACP doors: a WebSocket endpoint for ACP clients and a spawnable stdio agent mode. Ships the agent CLIs as bundled optional dependencies.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "agent-bridge": "cli.mjs"
  },
  "files": [
    "cli.mjs",
    "server.mjs",
    "serve.mjs",
    "doctor.mjs",
    "wire-ws.mjs",
    "acp-front.mjs",
    "acp-front-ws.mjs",
    "acp-front-stdio.mjs",
    "agents-registry.mjs",
    "agents.example.json",
    "docs/",
    "adapters/",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaohuzai/agent-bridge.git"
  },
  "keywords": [
    "agent",
    "codex",
    "claude",
    "acp",
    "agent-client-protocol",
    "bridge",
    "gateway",
    "cli",
    "sse",
    "local-llm",
    "byok"
  ],
  "bugs": {
    "url": "https://github.com/xiaohuzai/agent-bridge/issues"
  },
  "homepage": "https://github.com/xiaohuzai/agent-bridge#readme",
  "optionalDependencies": {
    "@openai/codex": "0.149.1",
    "@agentclientprotocol/claude-agent-acp": "^0.86.0",
    "@anthropic-ai/claude-code": "^2.1.291",
    "@google/gemini-cli": "^0.62.0",
    "pi-acp": "^0.0.34"
  }
}
